// Skema Prisma — LogiSend API
// Model data ditambahkan bertahap mengikuti milestone B2–B7 (lihat planbackend.md §5).
// B2: users, agent_profiles, refresh_tokens.
// B3: routes, rates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  agentProfile  AgentProfile?
  refreshTokens RefreshToken[]
  recipients    Recipient[]
  shipments     Shipment[]

  @@map("users")
}

model AgentProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  companyName     String
  companyAddress  String
  picName         String
  picPhone        String
  npwp            String?
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus, createdAt])
  @@map("agent_profiles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ServiceType {
  PORT_TO_PORT
  PORT_TO_DOOR
}

model Route {
  id                String      @id @default(cuid())
  serviceType       ServiceType
  destinationCode   String
  destinationName   String
  destinationRegion String
  estimatedDays     Int
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  rates     Rate[]
  shipments Shipment[]

  @@unique([serviceType, destinationCode])
  @@map("routes")
}

model Rate {
  id                  String   @id @default(cuid())
  routeId             String
  pricePerKg          BigInt
  minChargeableWeight Int
  baseFee             BigInt
  isActive            Boolean  @default(true)
  effectiveFrom       DateTime @default(now())
  createdAt           DateTime @default(now())

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, isActive])
  @@map("rates")
}

enum ShipmentStatus {
  PENDING_PAYMENT
  PAID
  RECEIVED_AT_WAREHOUSE
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum ShipmentPaymentStatus {
  UNPAID
  WAITING_VERIFICATION
  PAID
}

// Buku alamat. Tidak pernah direferensikan oleh shipments — data penerima
// disalin saat booking (planbackend.md §5.3.1), sehingga menghapus entri di
// sini tidak mengubah kiriman yang sudah jalan.
model Recipient {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  name       String
  phone      String
  address    String
  city       String
  postalCode String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recipients")
}

model Shipment {
  id             String                @id @default(cuid())
  userId         String
  routeId        String
  trackingNumber String                @unique
  serviceType    ServiceType
  status         ShipmentStatus        @default(PENDING_PAYMENT)
  previousStatus ShipmentStatus?
  paymentStatus  ShipmentPaymentStatus @default(UNPAID)

  // Disalin dari rute saat booking agar perubahan master data tidak
  // mengubah kiriman yang sudah terbit.
  destinationCode String
  destinationName String
  estimatedDays   Int

  senderName          String
  senderPhone         String
  recipientName       String
  recipientPhone      String
  recipientAddress    String
  recipientCity       String
  recipientPostalCode String?

  declaredWeight   Float
  actualWeight     Float?
  chargeableWeight Int
  totalColli       Int

  // Snapshot tarif — tagihan yang sudah terbit tidak boleh berubah (§5.3.2).
  pricePerKgSnapshot BigInt
  baseFeeSnapshot    BigInt
  totalAmount        BigInt
  outstandingAmount  BigInt

  notes        String?
  cancelReason String?
  deliveredTo  String?

  prohibitedItemsAgreedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id])
  route  Route           @relation(fields: [routeId], references: [id])
  items  ShipmentItem[]
  events ShipmentEvent[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([routeId, status])
  @@map("shipments")
}

model ShipmentItem {
  id            String   @id @default(cuid())
  shipmentId    String
  description   String
  quantity      Int
  weight        Float
  declaredValue BigInt?
  createdAt     DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_items")
}

// Append-only: tidak pernah di-update atau dihapus dari kode aplikasi.
// Koreksi dilakukan dengan menambah event baru (§5.3.3).
model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  location   String?
  notes      String?
  createdAt  DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt(sort: Desc)])
  @@map("shipment_events")
}
