// Skema Prisma — LogiSend API
// Model data ditambahkan bertahap mengikuti milestone B2–B7 (lihat planbackend.md §5).
// B2: users, agent_profiles, refresh_tokens.
// B3: routes, rates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  agentProfile  AgentProfile?
  refreshTokens RefreshToken[]

  @@map("users")
}

model AgentProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  companyName     String
  companyAddress  String
  picName         String
  picPhone        String
  npwp            String?
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus, createdAt])
  @@map("agent_profiles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ServiceType {
  PORT_TO_PORT
  PORT_TO_DOOR
}

model Route {
  id                String      @id @default(cuid())
  serviceType       ServiceType
  destinationCode   String
  destinationName   String
  destinationRegion String
  estimatedDays     Int
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  rates Rate[]

  @@unique([serviceType, destinationCode])
  @@map("routes")
}

model Rate {
  id                  String   @id @default(cuid())
  routeId             String
  pricePerKg          BigInt
  minChargeableWeight Int
  baseFee             BigInt
  isActive            Boolean  @default(true)
  effectiveFrom       DateTime @default(now())
  createdAt           DateTime @default(now())

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, isActive])
  @@map("rates")
}
