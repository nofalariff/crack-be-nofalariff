# === LogiSend API ===
# Salin berkas ini menjadi .env lalu sesuaikan nilainya.
# Aplikasi gagal start bila salah satu variabel wajib berikut kosong atau tidak valid.

# Koneksi PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logisend?schema=public

# Aplikasi
PORT=3001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS — daftar origin dipisah koma
CORS_ORIGINS=http://localhost:3000

# Penyimpanan berkas
STORAGE_DRIVER=local
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=5

# Instruksi transfer bank (FR-PAY-01)
BANK_NAME=Bank Contoh
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_HOLDER=PT LogiSend Indonesia

# Admin awal untuk seed
ADMIN_EMAIL=admin@logisend.id
ADMIN_PASSWORD=change-me-admin-password

# Swagger — nonaktifkan di production
SWAGGER_ENABLED=true

# Batas rate limit per menit per IP. Nilai di bawah ini adalah nilai
# production. Saat menjalankan rangkaian E2E frontend (58 pengujian paralel
# dari satu IP), longgarkan misalnya menjadi 1000 agar tidak tertahan.
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_RATE_CALCULATOR=30
RATE_LIMIT_DEFAULT=100
